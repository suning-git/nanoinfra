# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Training artifacts ---
*.pt
*.bin

# --- 3-root data layout: keep the dirs, ignore their contents ---
datasets/*
!datasets/.gitkeep
models/*
!models/.gitkeep
outputs/*
!outputs/.gitkeep

# Per-exemplar run output. NOT a bare `outputs/`: that would match the root one
# too, and git does not descend into an ignored directory, so `!outputs/.gitkeep`
# above could no longer re-include the scaffold.
exemplars/*/outputs/
projects/*/outputs/
# Same for per-exemplar checkpoints: the nano_world_model quickstart saves to
# exemplars/nano_world_model/models/<run> (configs/train_wm.yaml). Found by
# running the README in a fresh tree (2026-09-15): without this the first
# training run leaves its checkpoints as untracked files in git status.
exemplars/*/models/
projects/*/models/

# --- OS ---
.DS_Store
